# ---------------------------------------------------------------------------
# 本项目的额外规则
# ---------------------------------------------------------------------------
# 本地构建配置（含本机 SDK 路径，不入库）
android/local.properties
key.properties

# 签名私钥不入库：CI 通过 Repository Secrets 注入（见 SIGNING.md）。
# 仓库内只保留证书指纹（android/signing/fingerprint.txt），用于校验构建一致性。
*.jks
*.keystore

# 构建产物
*.apk
!docs/*.apk

# Android 构建产物（含 problems-report 等）
android/build/
/android/.gradle/
